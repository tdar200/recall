<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Debug-only: exported broadcast receiver driving headless engine tests via
      `adb shell am broadcast -n com.recall.app/.DebugReceiver -a ...`. Never
      shipped in release builds (this manifest only merges into debug variants).
    -->
    <application>
        <receiver
            android:name="com.recall.app.DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.recall.DEBUG_INGEST" />
                <action android:name="com.recall.DEBUG_DUMP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
